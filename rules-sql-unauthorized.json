{
  "java": [
    {
      "type": "SQL单条件WHERE子句风险",
      "keyStr": "WHERE单条件查询",
      "regExp": "(?i)(?!.*\\b(AND|OR)\\b).*\\bWHERE\\s+[\\w\\s'\"=?%$\\{\\}]+.*"
    },
    {
      "type": "MyBatis单条件查询风险",
      "keyStr": "MyBatis selectById",
      "regExp": "(?i).*\\b(selectById|getById|removeById|deleteById|updateById)\\s*\\("
    },
    {
      "type": "Spring JPA find方法风险",
      "keyStr": "EntityManager find",
      "regExp": "(?i).*\\b(EntityManager\\.find|session\\.get|session\\.load)\\s*\\("
    },
    {
      "type": "Hibernate createQuery单条件HQL风险",
      "keyStr": "Hibernate HQL query",
      "regExp": "(?i).*\\bsession\\.createQuery\\s*\\([^)]*[\"'].*\\bWHERE\\s+[\\w\\s'\"=?%$.\\{\\}]+(?!\\s*(AND|OR)\\s).*[\"']"
    },
    {
      "type": "Hibernate createCriteria单条件风险",
      "keyStr": "Hibernate Criteria",
      "regExp": "(?i).*\\bsession\\.createCriteria\\s*\\([^)]*\\)\\.\\s*(add\\(\\s*Restrictions\\.(eq|idEq)\\.\\(|setResultTransformer|list|uniqueResult)\\s*\\("
    },
    {
      "type": "Hibernate createSQLQuery单条件风险",
      "keyStr": "Hibernate Native SQL",
      "regExp": "(?i).*\\bsession\\.createSQLQuery\\s*\\([^)]*[\"'].*\\bWHERE\\s+[\\w\\s'\"=?%$.\\{\\}]+(?!\\s*(AND|OR)\\s).*[\"']"
    },
    {
      "type": "JFinal Model单条件操作风险",
      "keyStr": "JFinal findById",
      "regExp": "(?i).*\\b(findById|save|delete)\\s*\\([^)]*\\$\\{\\w+"
    },
    {
      "type": "SQL字符串拼接风险",
      "keyStr": "SQL String Concatenation",
      "regExp": "(?i).*\\b(SELECT|DELETE|UPDATE|INSERT)\\s+[^\"']*WHERE[^\"']*\\+\\s*\\w+.*"
    },
    {
      "type": "用户参数直接使用风险",
      "keyStr": "RequestParam in Query",
      "regExp": "(?i).*@(RequestParam|PathVariable|QueryParam|PathParam|FormParam)\\s*(\\([^)]*\\))?\\s*[A-Z]\\w*\\s+\\w+\\s*\\)[\\s\\S]{0,300}\\b(find|delete|update|query)\\s*\\("
    },
    {
      "type": "MyBatis XML单条件WHERE查询风险",
      "keyStr": "MyBatis XML WHERE",
      "regExp": "(?i)<(select|update|delete)[^>]*>[\\s\\S]*?\\bWHERE\\s+[\\w.]+\\s*=\\s*[#\\$]\\{[^}]+\\}[\\s\\S]*?</(select|update|delete)>(?![\\s\\S]*\\bAND\\b)(?![\\s\\S]*\\bOR\\b)"
    },
    {
      "type": "MyBatis XML ${}参数拼接风险",
      "keyStr": "MyBatis XML ${} Injection",
      "regExp": "(?i)<(select|update|delete|insert)[^>]*>[\\s\\S]*?\\$\\{[^}]+\\}[\\s\\S]*?</(select|update|delete|insert)>"
    },
    {
      "type": "MyBatis XML单ID查询风险",
      "keyStr": "MyBatis XML selectById",
      "regExp": "(?i)<(select|update|delete)[^>]*\\bid=\"[^\"]*(ById|byId|by_id)[^\"]*\"[^>]*>"
    },
    {
      "type": "MyBatis XML动态SQL单条件风险",
      "keyStr": "MyBatis XML Dynamic SQL",
      "regExp": "(?i)<(select|update|delete)[^>]*>[\\s\\S]*?<where>[\\s\\S]*?</where>[\\s\\S]*?</(select|update|delete)>"
    },
    {
      "type": "MyBatis XML like拼接风险",
      "keyStr": "MyBatis XML LIKE",
      "regExp": "(?i)<(select|update|delete)[^>]*>[\\s\\S]*?\\bLIKE\\s+['\"]?%?[#\\$]\\{[^}]+\\}['\"]?[\\s\\S]*?</(select|update|delete)>"
    }
  ],
  "php": [
    {
      "type": "SQL单条件WHERE子句风险",
      "keyStr": "WHERE单条件查询",
      "regExp": "(?i)(?!.*\\b(AND|OR)\\b).*\\bWHERE\\s+[\\w\\s'\"=?%$.\\{\\}]+.*"
    },
    {
      "type": "Laravel Eloquent find操作风险",
      "keyStr": "Laravel find",
      "regExp": "(?i).*->find\\s*\\([^)]*\\$\\w+.*"
    },
    {
      "type": "Laravel Eloquent where单条件风险",
      "keyStr": "Laravel where",
      "regExp": "(?i).*->where\\s*\\(\\s*['\"]\\w+['\"]\\s*,\\s*['\"]\\s*=\\s*['\"]\\s*,\\s*\\$\\w+"
    },
    {
      "type": "Doctrine find操作风险",
      "keyStr": "Doctrine find",
      "regExp": "(?i).*->find\\s*\\([^,]*,\\s*\\$\\w+.*"
    },
    {
      "type": "GET/POST参数直接使用风险",
      "keyStr": "$_GET param in query",
      "regExp": "(?i).*\\$_(GET|POST|REQUEST)\\[['\"]\\w+['\"]\\].*[\\s\\S]{0,150}(find|delete|update|query)\\s*\\("
    }
  ],
  "go": [
    {
      "type": "SQL单条件WHERE子句风险",
      "keyStr": "WHERE单条件查询",
      "regExp": "(?i)(?!.*\\b(AND|OR)\\b).*\\bWHERE\\s+[\\w\\s'\"=?%$\\{\\}]+.*"
    },
    {
      "type": "GORM First/Find单条件风险",
      "keyStr": "GORM First",
      "regExp": "(?i).*\\.(First|Find)\\s*\\([^,]*,\\s*[&*]\\w+.*"
    },
    {
      "type": "GORM Where单条件风险",
      "keyStr": "GORM Where",
      "regExp": "(?i).*\\.Where\\s*\\([^)]*[\"']\\w+[\"']\\s*=\\s*\\?[\"']?[^)]*\\)\\."
    },
    {
      "type": "GORM Delete单条件风险",
      "keyStr": "GORM Delete",
      "regExp": "(?i).*\\.Delete\\s*\\([^,]*\\)\\s*\\.\\s*Where\\s*\\("
    },
    {
      "type": "database/sql Query单条件风险",
      "keyStr": "db Query",
      "regExp": "(?i).*\\.(Query|QueryRow|Exec)\\s*\\([^)]*\"[^\"]*WHERE[^\"']*(?!(AND|OR))[\"'].*"
    },
    {
      "type": "Gin路由参数直接使用风险",
      "keyStr": "c.Param in query",
      "regExp": "(?i).*c\\.Param\\s*\\([^)]*\\).*[\\s\\S]{0,100}(First|Find|Where|Query)\\s*\\("
    },
    {
      "type": "Gin查询参数直接使用风险",
      "keyStr": "c.Query in query",
      "regExp": "(?i).*c\\.(Query|DefaultQuery)\\s*\\([^)]*\\).*[\\s\\S]{0,100}(First|Find|Where|Query)\\s*\\("
    }
  ]
}
